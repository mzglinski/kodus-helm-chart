{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": {},
          "valueFrom": { "type": "object" }
        },
        "anyOf": [
          { "required": ["value"] },
          { "required": ["valueFrom"] }
        ]
      }
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "registry": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string" }
      },
      "additionalProperties": true
    },
    "global": {
      "type": "object",
      "properties": {
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
        "extraEnv": { "$ref": "#/definitions/extraEnv" },
        "extraVolumes": { "type": "array" },
        "extraVolumeMounts": { "type": "array" }
      },
      "additionalProperties": true
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "keys": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "externalPostgresql": {
      "type": "object",
      "oneOf": [
        {
          "required": ["host"],
          "properties": {
            "host": { "type": "string", "minLength": 1 }
          }
        },
        {
          "required": ["uri"],
          "properties": {
            "uri": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "properties": {
        "uri": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "database": { "type": "string" },
        "username": { "type": "string" },
        "existingSecret": { "type": "string" },
        "passwordKey": { "type": "string" }
      }
    },
    "externalMongodb": {
      "type": "object",
      "oneOf": [
        {
          "required": ["host"],
          "properties": {
            "host": { "type": "string", "minLength": 1 }
          }
        },
        {
          "required": ["uri"],
          "properties": {
            "uri": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "properties": {
        "uri": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "database": { "type": "string" },
        "username": { "type": "string" },
        "authSource": { "type": "string" },
        "existingSecret": { "type": "string" },
        "passwordKey": { "type": "string" }
      }
    },
    "externalRabbitmq": {
      "type": "object",
      "oneOf": [
        {
          "required": ["host"],
          "properties": {
            "host": { "type": "string", "minLength": 1 }
          }
        },
        {
          "required": ["uri"],
          "properties": {
            "uri": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "properties": {
        "uri": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "vhost": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "existingSecret": { "type": "string" },
        "usernameKey": { "type": "string" },
        "passwordKey": { "type": "string" }
      }
    },
    "langfuse": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "publicKey": { "type": "string" },
        "baseUrl": { "type": "string" },
        "environment": { "type": "string" }
      },
      "additionalProperties": false
    },
    "worker": {
      "type": "object",
      "properties": {
        "healthPort": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
        "extraEnv": { "$ref": "#/definitions/extraEnv" }
      },
      "additionalProperties": true
    },
    "web": {
      "type": "object",
      "properties": {
        "mcpManagerHostname": { "type": "string" },
        "apiHostname": { "type": "string" },
        "extraEnv": { "$ref": "#/definitions/extraEnv" }
      },
      "additionalProperties": true
    },
    "api": {
      "type": "object",
      "properties": {
        "extraEnv": { "$ref": "#/definitions/extraEnv" }
      },
      "additionalProperties": true
    },
    "webhooks": {
      "type": "object",
      "properties": {
        "extraEnv": { "$ref": "#/definitions/extraEnv" }
      },
      "additionalProperties": true
    },
    "workerAnalytics": {
      "type": "object",
      "properties": {
        "extraEnv": { "$ref": "#/definitions/extraEnv" }
      },
      "additionalProperties": true
    },
    "mcpManager": {
      "type": "object",
      "properties": {
        "extraEnv": { "$ref": "#/definitions/extraEnv" }
      },
      "additionalProperties": true
    },
    "cronRunner": {
      "type": "object",
      "properties": {
        "api": {
          "type": "object",
          "properties": {
            "extraEnv": { "$ref": "#/definitions/extraEnv" }
          },
          "additionalProperties": true
        },
        "worker": {
          "type": "object",
          "properties": {
            "extraEnv": { "$ref": "#/definitions/extraEnv" }
          },
          "additionalProperties": true
        },
        "workerAnalytics": {
          "type": "object",
          "properties": {
            "extraEnv": { "$ref": "#/definitions/extraEnv" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "jobs": {
      "type": "object",
      "properties": {
        "migrations": {
          "type": "object",
          "properties": {
            "extraEnv": { "$ref": "#/definitions/extraEnv" }
          },
          "additionalProperties": true
        },
        "seeds": {
          "type": "object",
          "properties": {
            "extraEnv": { "$ref": "#/definitions/extraEnv" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "ingress": {
      "type": "object",
      "properties": {
        "api": {
          "type": "object",
          "properties": {
            "tls": { "type": "boolean" }
          }
        },
        "web": {
          "type": "object",
          "properties": {
            "tls": { "type": "boolean" }
          }
        }
      },
      "additionalProperties": true
    }
  }
}
